#include <iostream>
#include <string>
#include <vector>
#include <limits> // Necessário para usar numeric_limits

using namespace std; // Para evitar digitar std:: antes de cout, cin, etc.

int main() {
    int opcao;
    int n = 0; // Quantidade de nomes
    vector<string> nomes; // O vetor começa vazio e fica fora do menu

    do {
        cout << "\n--- MENU ---" << endl;
        cout << "1 - Definir a quantidade de nomes" << endl;
        cout << "2 - Cadastrar nomes" << endl;
        cout << "3 - Listar nomes" << endl;
        cout << "4 - Sair" << endl;
        cout << "Opcao: ";
        cin >> opcao;
        
        // Limpa o buffer após ler a opção do menu
        cin.ignore(numeric_limits<streamsize>::max(), '\n');

        switch(opcao) {
            case 1:
                cout << "Quantos nomes voce deseja digitar? ";
                cin >> n;
                cin.ignore(numeric_limits<streamsize>::max(), '\n'); // Limpa o enter
                
                // Redimensiona o vetor para o tamanho que o usuário escolheu
                nomes.resize(n);
                cout << "Quantidade definida para " << n << " alunos.\n";
                break;

            case 2:
                if (n == 0) {
                    cout << "[ERRO] Defina a quantidade de nomes na opcao 1 primeiro!\n";
                } else {
                    // Loop para ler os 'n' nomes completos
                    for (int i = 0; i < n; i++) {
                        cout << "Digite o " << i + 1 << "o nome completo: ";
                        getline(cin, nomes[i]);
                    }
                    cout << "Nomes cadastrados com sucesso!\n";
                }
                break;

            case 3:
                if (nomes.empty() || n == 0) {
                    cout << "[AVISO] Nenhum aluno cadastrado ainda.\n";
                } else {
                    // Loop para exibir os nomes na tela
                    cout << "\n--- LISTA DE ALUNOS ---\n";
                    for (int i = 0; i < n; i++) {
                        cout << i + 1 << ". " << nomes[i] << endl;
                    }
                }
                break;

            case 4:
                cout << "Saindo do programa...\n";
                break;

            default:
                cout << "Opcao invalida! Tente novamente.\n";
                break;
        }

    } while (opcao != 4); // O menu continua rodando até a opção ser 4

    return 0;
}
