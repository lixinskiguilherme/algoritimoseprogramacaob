//O SISTEMA CADASTRA OS DADOS DO ALUNO TUDO UMA UNICA VEZ
//1. Cadastro simples de alunos
//Crie uma struct Aluno com os campos: nome, matricula e nota. Faça um programa que leia 5 alunos , 
//armazene-os em um vetor de structs e exiba todos na tela.

#include<iostream>
#include<string>
#include<limits>

#define TAM 5

using namespace std;

struct Aluno {
	string nome;
	int matricula;
	float nota;
};

int main(){
	cout <<"Faça um programa que leia 5 alunos , armazene-os em um vetor de structs e exiba todos na tela." <<endl;
	Aluno alunos [TAM];
	int quantidadeInseridos = 0;
	int opcao;
		
	do {
		cout<<"MENU" <<endl;
		cout<<"1 - Cadastrar aluno (nome, matrícula e nota)" <<endl;
		cout<<"2 - Listar alunos" <<endl;
		cout<<"3 - Sair" <<endl;
		cout<<"Opcao: ";
		cin>> opcao;
		cin.ignore(numeric_limits<streamsize>:: max(), '\n');
	
		switch(opcao){
			case 1: // CADASTRO COMPLETO DO ALUNO
				cout<<"Cadastre os dados do aluno" <<endl;
				if (quantidadeInseridos < TAM){
					cout<<"Nome do aluno: " <<quantidadeInseridos +1 << ": ";
					
					cout<<"Nome: ";
					getline(cin, alunos[quantidadeInseridos].nome);
					
					cout<<"Matricula: ";
					cin>> alunos[quantidadeInseridos].matricula;
					
					cout<<"Nota: ";
					cin>> alunos[quantidadeInseridos].nota;
					
					quantidadeInseridos++;
					cout<<"Nome cadastrado com sucesso" <<endl;
				} else{
					cout<<"VETOR LOTADO!"<<endl;
				}
				break;
				
			case 2: // listar alunos
				cout<<"Listar os alunos" <<endl;
				if (quantidadeInseridos == 0){
					cout<<"Nenhum aluno cadastrado";
				} else{
					cout<<"----------------"<<endl;
					for (int i = 0; i<quantidadeInseridos; i++){
						cout<<"Aluno" <<i + 1 << " : " <<endl;
						cout<<"Nome: " <<alunos[i].nome <<endl;
						cout<<"Matricula: " <<alunos[i].matricula <<endl;
						cout<<"Nota: " <<alunos[i].nota <<endl;
						cout<<"----------------"<<endl;
				}
		}
				break;
			case 3:
				cout<<"Saindo ..." <<endl;
				break;
			default:
				cout<<"Opcao invalida" <<endl;
		}
	}while (opcao !=3);	
		
	return 0;
}
