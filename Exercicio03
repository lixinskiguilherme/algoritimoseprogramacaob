//1) Fazer um programa em C ou C++ que preencha um vetor de string com n nomes e exiba-os

#include <iostream> //stdio.h
#include <string>   //string.h
#include <limits>   // Para limpar o buffer corretamente

#define TAM 4

using namespace std;

int main() {
    cout << "Fazer um programa em C ou C++ que preencha um vetor de string com n nomes e exiba-os" << endl;
    string nomes[TAM];
    int quantidadeInseridos = 0;
    int opcao;
    string nome;
    do {
        cout << "MENU" << endl;
        cout << "1 - Cadastrar nomes" << endl;
        cout << "2 - Listar nomes" << endl;
        cout << "3 - Pesquisar nome" << endl;
        cout << "4 - Ordenar nomes" << endl;
        cout << "5 - Sair" << endl;
        cout << "Opcao: ";
        cin >> opcao;
        cin.ignore(numeric_limits<streamsize>::max(), '\n'); // LIMPA O BUFFER CORRETAMENTE

        switch (opcao)
        {
        case 1:
            cout << "Cadastrar nomes ..." << endl;
            if (quantidadeInseridos == TAM) {
                cout << "Vetor lotado...." << endl;
            } else {
                // CADASTRA APENAS 1 NOME POR VEZ
                cout << "Nome: ";
                getline(cin, nome);
                //rotina que verifica se o nome ja esta no vetor de nomes

                nomes[quantidadeInseridos] = nome;
                quantidadeInseridos++;
                cout << "Nome cadastrado com sucesso!" << endl;
            }
            break;
        case 2:
            cout << "Listar nomes ..." << endl;
            if (quantidadeInseridos == 0) {
                cout << "Vetor de nomes vazio... nada a exibir ..." << endl;
            } else {
                for (int i = 0; i < quantidadeInseridos; i++) {
                    cout << "Nome " << (i+1) << ": " << nomes[i] << endl;
                }
                cout << "-----------------" << endl;
                cout << "Total de registros: " << quantidadeInseridos << endl;
            }
            break;
        case 3:
            cout << "Pesquisar nome ..." << endl;
            if (quantidadeInseridos == 0) {
                cout << "Vetor de nomes vazio... nao eh possivel pesquisa ..." << endl;
            } else {
                cout << "Nome para pesquisa: ";
                getline(cin, nome);
                int quantidadeLocalizados = 0;
                for (int i = 0; i < quantidadeInseridos; i++) {
                    // CORREÇÃO: find retorna npos se não encontrar
                    if (nomes[i].find(nome) != string::npos) {
                        cout << nomes[i] << endl;
                        quantidadeLocalizados++;
                    }
                }
                cout << "-----------------" << endl;
                cout << "Total de registros encontrados: " << quantidadeLocalizados << endl;
            }
            break;
        case 4:
            cout << "Ordenando o vetor de nomes..." << endl;
            // APLICA O BUBBLE SORT NO VETOR DE NOMES
            if (quantidadeInseridos == 0) {
                cout << "Vetor vazio... nada para ordenar!" << endl;
            } else {
                for (int i = 0; i < quantidadeInseridos - 1; i++) {
                    for (int j = 0; j < quantidadeInseridos - i - 1; j++) {
                        // COMPARA OS NOMES E TROCA SE ESTIVEREM FORA DE ORDEM
                        if (nomes[j] > nomes[j + 1]) {
                            string temp = nomes[j];
                            nomes[j] = nomes[j + 1];
                            nomes[j + 1] = temp;
                        }
                    }
                }
                cout << "Vetor ordenado com sucesso!" << endl;
                // EXIBE O VETOR ORDENADO
                cout << "Vetor ordenado:" << endl;
                for (int i = 0; i < quantidadeInseridos; i++) {
                    cout << "Nome " << (i+1) << ": " << nomes[i] << endl;
                }
            }
            break;
        case 5:
            cout << "Saindo do programa ..." << endl;
            break;
        default:
            cout << "Opcao invalida..." << endl;
            break;
        }
    } while (opcao != 5);
    return 0; // 0 INDICA SUCESSO
}
